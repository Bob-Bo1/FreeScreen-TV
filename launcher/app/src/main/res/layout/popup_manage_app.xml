<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/glass_panel">
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="12dp">
        <ImageView android:id="@+id/manage_art" android:layout_width="112dp" android:layout_height="63dp"
            android:scaleType="fitCenter" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:orientation="vertical">
            <TextView android:id="@+id/manage_kicker" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="整理应用" android:textSize="12sp" android:textColor="#99FFFFFF" />
            <TextView android:id="@+id/manage_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="22sp" android:textColor="#FFFFFFFF"
                android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/manage_rows" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="14dp" android:paddingBottom="2dp" android:gravity="center"
        android:text="方向键选择　·　确定执行　·　返回关闭" android:textSize="11sp" android:textColor="#99FFFFFF" />
</LinearLayout>
